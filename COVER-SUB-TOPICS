package Arr;

public class Implementing_Selection_Sort {

	public static void main(String[] args) { 
		int[] arr = {64, 25, 12, 22, 11}; 
		int n = arr.length; 
		for (int i =  ; i < n - 1; i++) { 
		int minIndex = i; 
		for (int j = i + 1; j < n; j++) { 
		if (arr[j] < arr[minIndex]) { 
		minIndex = j; 
		} 
		} 
		int temp = arr[minIndex]; 
		arr[minIndex] = arr[i]; 
		arr[i] = temp; 
		} 
		for (int num : arr) { 
		System.out.print(num + " "); 
		} 
		} 
		} 

