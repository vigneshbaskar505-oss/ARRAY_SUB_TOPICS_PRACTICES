package Arr;

public class Print_the_Prime_Numbers_in_a_Range {

	public static void main(String[] args) { 
		int start = 10, end = 50; 
		for (int num = start; num <= end; num++) { 
		boolean isPrime = true; 
		for (int i = 2; i <= Math.sqrt(num); i++) { 
		if (num % i == 0) { 
		isPrime = false; 
		break; 
		} 
		} 
		if (isPrime && num > 1) { 
		System.out.print(num + " "); 
		} 
		} 
		} 
		} 
